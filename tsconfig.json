{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Node",

    "strict": true,

    "declaration": false,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "outDir": "dist",

    "lib": ["DOM", "ES2022"],
  },

  "include": ["src/**/*"],
}
